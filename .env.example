# SQLite is the safe zero-configuration default. Relative paths are resolved
# from the repository root when Uvicorn is started there.
FIL_AI_DATABASE_URL=sqlite:///./data/fil_ai.db

# PostgreSQL alternative (never commit the real password):
# FIL_AI_DATABASE_URL=postgresql+psycopg://fil_ai:change_me@localhost:5432/fil_ai

FIL_AI_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Leave false for PostgreSQL so Alembic remains the schema authority.
# SQLite is initialized additively regardless of this flag.
FIL_AI_AUTO_CREATE_DB=false
FIL_AI_SQL_ECHO=false
# The default REST model remains the preserved baseline. CAMeLBERT is loaded
# only when explicitly requested by the UI/API.
FIL_AI_MODEL_PATH=
FIL_AI_CAMELBERT_MODEL_PATH=models/FIL_AI_CAMeLBERT
# auto selects MPS when available, otherwise CPU. Explicit values: mps or cpu.
FIL_AI_TRANSFORMER_DEVICE=auto

# Semantic context matching. The model is cached once under models/embedding_cache.
FIL_AI_EMBEDDING_ENABLED=true
FIL_AI_EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
FIL_AI_EMBEDDING_CACHE_DIR=models/embedding_cache
FIL_AI_EMBEDDING_LOCAL_FILES_ONLY=false
FIL_AI_SEMANTIC_THRESHOLD=0.55
